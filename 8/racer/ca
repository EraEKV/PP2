class Game():
  def __init__(self):
    self.score = 0
    self.level = 1

    self.food_pos = [random.randrange(1, (WIDTH//10)) * 10, random.randrange(1, (HEIGHT//10)) * 10]
    self.food_spawn = True

    # Fonts
    self.font1 = 'consolas'
    self.font2 = 'time new roman'
    
    # Colors 
    self.black = pygame.Color(0, 0, 0)
    self.white = pygame.Color(255, 255, 255)
    self.red = pygame.Color(255, 0, 0)
    self.green = pygame.Color(0, 255, 0)
    self.blue = pygame.Color(0, 0, 255)

  def show_score(self):
    score_font = pygame.font.SysFont(self.font1, 20)
    score_surface = score_font.render('Score : ' + str(self.score), True, self.green)
    score_rect = score_surface.get_rect()
    game_window.blit(score_surface, score_rect)
  
  def game_over(self):
    my_font = pygame.font.SysFont(font2, 90)
    game_over_surface = my_font.render('YOU DIED', True, red)
    game_over_rect = game_over_surface.get_rect()
    game_over_rect.midtop = (WIDTH/2, HEIGHT/4)
    game_window.fill(black)
    game_window.blit(game_over_surface, game_over_rect)
    show_score(0, red, 'times', 20)
    pygame.display.flip()
    time.sleep(1.5)
    pygame.quit()
    sys.exit()

# Snake object
class Snake(pygame.sprite.Sprite, Game):
  def __init__(self):
    super().__init__()
    self.image = pygame.Surface([10, 10])
    self.image.fill(green)
    self.rect = self.image.get_rect()
    self.snake_pos = [100, 50]
    self.snake_body = [[100, 50], [100-10, 50], [100-(2*10), 50]]
    self.rect.x = snake_pos[0]
    self.rect.y = snake_pos[1]
    self.direction = "RIGHT"
    self.change_to = "RIGHT"

  def check_event(self, event) -> None:
    if event == pygame.K_UP or event == ord('w'):
      self.change_to = 'UP'
    if event == pygame.K_DOWN or event == ord('s'):
      self.change_to = 'DOWN'
    if event == pygame.K_LEFT or event == ord('a'):
      self.change_to = 'LEFT'
    if event == pygame.K_RIGHT or event == ord('d'):
      self.change_to = 'RIGHT'
    if event == pygame.K_ESCAPE:
      pygame.event.post(pygame.event.Event(pygame.QUIT))

  def check_direction(self) -> None:
    # Snake can't crash into itself on opposite direction
    if change_to == 'UP' and self.direction != 'DOWN':
        self.direction = 'UP'
    if change_to == 'DOWN' and self.direction != 'UP':
        self.direction = 'DOWN'
    if change_to == 'LEFT' and self.direction != 'RIGHT':
        self.direction = 'LEFT'
    if change_to == 'RIGHT' and self.direction != 'LEFT':
        self.direction = 'RIGHT'

    if direction == 'UP':
      snake_pos[1] -= 10
    if direction == 'DOWN':
      snake_pos[1] += 10
    if direction == 'LEFT':
      snake_pos[0] -= 10
    if direction == 'RIGHT':
      snake_pos[0] += 10

  def snake_growing(self) -> None:
    snake_body.insert(0, list(snake_pos))
    global score, food_spawn
    if snake_pos[0] == food_pos[0] and snake_pos[1] == food_pos[1]:
        score += 1
        food_spawn = False
    else:
        snake_body.pop()

